<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout da MainActivity — painel de controle do Dashcam.
    PreviewView ocupa o fundo (fullscreen); overlay de controles na parte inferior.
    Preview está GONE por padrão; torna-se VISIBLE apenas quando o toggle está ON.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <!-- Preview da câmera — oculto por padrão (economia de RAM/GPU) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Painel de controles — fundo semi-transparente na parte inferior -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/panel_background"
        android:padding="16dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Status da gravação -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_stopped"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- Linha de botões principais -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <!-- Botão Iniciar / Parar -->
            <Button
                android:id="@+id/btnRecord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_start"
                android:backgroundTint="@color/btn_record"
                android:layout_marginEnd="16dp" />

            <!-- Botão Trocar Câmera -->
            <Button
                android:id="@+id/btnSwitchCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_switch_camera"
                android:enabled="false"
                android:backgroundTint="@color/btn_switch" />

        </LinearLayout>

        <!-- Toggle Preview -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/toggle_preview"
            android:textColor="@color/text_primary"
            android:checked="false" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
