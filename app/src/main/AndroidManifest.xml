<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ================================================================
         Permissões de hardware
    ================================================================ -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- ================================================================
         Permissões de serviço em segundo plano
    ================================================================ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: tipos específicos de foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Mantém CPU ativa com tela bloqueada -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 13+: obrigatório para exibir notificação persistente -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ================================================================
         Declarações de hardware
         required=false evita filtro indevido na Play Store
    ================================================================ -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarCan"
        android:largeHeap="false">

        <!-- ============================================================
             MainActivity — painel de controle
        ============================================================ -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ============================================================
             RecordingService — Foreground Service de gravação
             stopWithTask=false: sobrevive ao swipe na recents list
             foregroundServiceType: obrigatório no Android 14+
        ============================================================ -->
        <service
            android:name=".RecordingService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="camera|microphone" />

    </application>

</manifest>
